# ==============================================================================
# RetailFix Backend Environment Configuration Template
# Set these environment variables in your Render Dashboard (Settings > Environment)
# ==============================================================================

# Application Settings
PROJECT_NAME="RETAILFIX Store Survey & 2D CAD Platform"
API_V1_STR="/api"

# JWT Authentication
SECRET_KEY="replace_with_a_secure_random_64_character_hex_string"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Connection (Neon PostgreSQL)
# IMPORTANT: Must use postgresql+asyncpg:// prefix for SQLAlchemy async engine
DATABASE_URL="postgresql+asyncpg://username:password@ep-unique-id.region.aws.neon.tech/retailfix?sslmode=require"

# Initial Superadmin Credentials (Seeded on startup if not present)
DEFAULT_ADMIN_USERNAME="admin"
DEFAULT_ADMIN_PASSWORD="replace_with_secure_admin_password"
DEFAULT_ADMIN_EMAIL="admin@retailfix.com"

# CORS Origins (JSON array of allowed frontend origins)
BACKEND_CORS_ORIGINS='["http://localhost:5173", "https://localhost:3000", "https://2d-layoutfrontend.vercel.app"]'
